{
  "name": "chestnut-code",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.2",
      "varlock": "1.18.0",
      "@trpc/server": "^11.18.0",
      "lucide-react": "^1.41.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "@trpc/client": "^11.18.0",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build --filter='!desktop' && turbo run build -F desktop",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "dev:desktop": "turbo run dev:hmr -F desktop --",
    "build:desktop": "turbo run build:stable -F desktop --",
    "build:desktop:canary": "turbo run build:canary -F desktop --",
    "dev:tui": "turbo run dev -F tui --",
    "dev:server": "turbo run dev -F server --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/",
    "check": "biome check --write ."
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@chestnut-code/config": "workspace:*",
    "@types/bun": "catalog:",
    "lefthook": "^2.1.12",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.2"
}
